							"path": ["booking", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "booking-id-here"
								}
							]
						},
						"description": "Get specific booking details"
					}
				}
			],
			"description": "Booking management endpoints for customers and painters"
		},
