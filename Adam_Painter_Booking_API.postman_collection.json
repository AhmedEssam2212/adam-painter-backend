{
	"info": {
		"_postman_id": "adam-painter-booking-api",
		"name": "Adam Painter Booking API",
		"description": "Complete API collection for the Adam Painter Booking System with authentication, availability management, and automatic painter assignment. Features weekend booking support and first-available painter selection.",
