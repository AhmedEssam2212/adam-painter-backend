				{
					"name": "Get My Bookings",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    const userRole = pm.collectionVariables.get('user_role');",
									"    console.log('✅ My bookings retrieved successfully');",
									"    console.log('👤 User role:', userRole);",
									"    console.log('📋 Total bookings:', response.data.length);",
									"    if (response.data.length > 0) {",
									"        console.log('📅 First booking:', response.data[0].startTime, 'to', response.data[0].endTime);",
									"        console.log('📊 Status:', response.data[0].status);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/bookings/me",
							"host": ["{{base_url}}"],
							"path": ["bookings", "me"]
						},
						"description": "Get current user's bookings. Returns customer bookings if logged in as customer, painter bookings if logged in as painter. The API automatically filters based on the authenticated user's role and ID."
					}
				},
				{
					"name": "Update Booking Status (Painter Only)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"CONFIRMED\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/booking/:id/status",
							"host": ["{{base_url}}"],
							"path": ["booking", ":id", "status"],
							"variable": [
								{
									"key": "id",
									"value": "booking-id-here"
								}
							]
						},
						"description": "Update booking status (PENDING, CONFIRMED, CANCELLED)"
					}
				},
				{
					"name": "Cancel Booking (Customer or Painter)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    const userRole = pm.collectionVariables.get('user_role');",
									"    console.log('✅ Booking cancelled successfully');",
									"    console.log('👤 Cancelled by:', userRole);",
									"    console.log('📋 Booking ID:', response.data.bookingId);",
									"    console.log('📊 New status:', response.data.status);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/bookings/{{booking_id}}/cancel",
							"host": ["{{base_url}}"],
							"path": ["bookings", "{{booking_id}}", "cancel"]
						},
						"description": "Cancel a booking. Both customers and painters can cancel bookings they are involved in. No request body needed - the API automatically sets status to CANCELLED."
					}
				},
