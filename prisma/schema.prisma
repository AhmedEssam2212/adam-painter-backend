// Adam Painter Booking System - Database Schema
// This schema defines the core entities for the painter booking system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles enum
enum UserRole {
  ADMIN
  PAINTER
  CUSTOMER
}

// Booking status enum
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Users table - handles both painters and customers
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignedJobs       Booking[]      @relation("PainterBookings") // Bookings assigned to this painter
  createdAvailabilities Availability[] @relation("CreatedAvailabilities") // Availabilities created by this user
  createdBookings    Booking[]      @relation("CreatedBookings") // Bookings created by this user

  @@map("users")
}

// Availability slots defined by painters
model Availability {
  id        String   @id @default(uuid())
  createdBy String   // User who created this availability (must be PAINTER or ADMIN)
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creator   User      @relation("CreatedAvailabilities", fields: [createdBy], references: [id], onDelete: Cascade)
  bookings  Booking[] // Bookings that use this availability

  // Constraints
  @@index([createdBy])
  @@index([startTime, endTime])
  @@map("availabilities")
}

// Booking requests and assignments
model Booking {
  id             String        @id @default(uuid())
  painterId      String?       // Assigned painter (nullable until assigned)
  availabilityId String?       // Reference to the availability slot used
  createdBy      String        // User who created this booking (must be CUSTOMER or ADMIN)
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  painter      User?         @relation("PainterBookings", fields: [painterId], references: [id], onDelete: SetNull)
  creator      User          @relation("CreatedBookings", fields: [createdBy], references: [id], onDelete: Cascade)
  availability Availability? @relation(fields: [availabilityId], references: [id], onDelete: SetNull)

  // Constraints
  @@index([painterId])
  @@index([createdBy])
  @@index([startTime, endTime])
  @@index([status])
  @@map("bookings")
}
